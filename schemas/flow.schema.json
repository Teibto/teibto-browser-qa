{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Teibto/teibto-browser-qa/schemas/flow.schema.json",
  "title": "TEIBTO Browser QA flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["story", "title", "scenarios"],
  "properties": {
    "story": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "title": {"type": "string", "minLength": 1},
    "ticket": {"type": "string"},
    "target": {"type": "string"},
    "vars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "label": {"type": "string"},
          "default": {"type": ["string", "number", "boolean", "null"]},
          "secret": {"type": "boolean"}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
          "doc": {"type": "boolean"},
          "requirement": {"type": "string"},
          "acceptance": {"type": "string"},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/step"}
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url_contains"],
          "properties": {"url_contains": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "contains"],
          "properties": {
            "target": {"type": "string"},
            "contains": {"type": "string"}
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "intent": {"type": "string"},
        "action": {"enum": ["open", "fill", "click", "select", "press", "scrollintoview", "eval", "wait"]},
        "target": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "wait": {"anyOf": [{"const": "networkidle"}, {"type": "integer", "minimum": 0, "maximum": 60000}, {"type": "string", "minLength": 1}]},
        "assert": {"$ref": "#/$defs/assertion"},
        "capture": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"enum": ["open", "fill", "click", "select", "press", "scrollintoview", "eval", "wait"]}}},
          "then": {"required": ["target"]}
        },
        {
          "if": {"properties": {"action": {"enum": ["fill", "select"]}}},
          "then": {"required": ["value"]}
        }
      ]
    }
  }
}
